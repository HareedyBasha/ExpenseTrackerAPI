{
    "swagger": "2.0",
    "info": {
        "description": "REST API for wallet and transaction management with JWT auth and RBAC.",
        "title": "ExpenseTracker API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "paths": {
        "/transactions": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Shows user's transactions with optional filters like category and from and to dates, where the displayed amount is determined by page and limit",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transaction"
                ],
                "summary": "Retrieves user's transactions",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Which page of the transactions list to show",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "How many transactions to show in each page",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Which category of transactions to show (case-insensitive)",
                        "name": "category",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Which date to start showing transactions after in RFC3339",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Which date to start showing transactions before in RFC3339",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.Transaction"
                            }
                        }
                    },
                    "400": {
                        "description": "failed to parse a query param",
                        "schema": {
                            "$ref": "#/definitions/dto.Error400"
                        }
                    },
                    "401": {
                        "description": "invalid authorization",
                        "schema": {
                            "$ref": "#/definitions/dto.Error401"
                        }
                    },
                    "500": {
                        "description": "failed to correctly query the database or parse claims",
                        "schema": {
                            "$ref": "#/definitions/dto.Error500"
                        }
                    }
                }
            }
        },
        "/transactions/summary": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Shows user's transactions grouped by category and formatted to be concise and nice to read",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transaction"
                ],
                "summary": "Retrieves a summary of user's transactions",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.SummaryResult"
                        }
                    },
                    "400": {
                        "description": "failed to parse a query param",
                        "schema": {
                            "$ref": "#/definitions/dto.Error400"
                        }
                    },
                    "401": {
                        "description": "invalid authorization",
                        "schema": {
                            "$ref": "#/definitions/dto.Error401"
                        }
                    },
                    "500": {
                        "description": "failed to correctly query the database or parse claims",
                        "schema": {
                            "$ref": "#/definitions/dto.Error500"
                        }
                    }
                }
            }
        },
        "/wallet": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Shows user's wallet's balance and user id or another user's wallet if the issuer is an admin and inputs an id as a query parameter",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "wallet"
                ],
                "summary": "Retrieves user's wallet info",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "User's id if admin wants to query another user's wallet",
                        "name": "id",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.Wallet200Response"
                        }
                    },
                    "400": {
                        "description": "invalid request body",
                        "schema": {
                            "$ref": "#/definitions/dto.Error400"
                        }
                    },
                    "401": {
                        "description": "invalid authorization",
                        "schema": {
                            "$ref": "#/definitions/dto.Error401"
                        }
                    },
                    "403": {
                        "description": "user not authorized to view this wallet",
                        "schema": {
                            "$ref": "#/definitions/dto.Error403"
                        }
                    },
                    "404": {
                        "description": "inputted username not found in database",
                        "schema": {
                            "$ref": "#/definitions/dto.Error404"
                        }
                    },
                    "500": {
                        "description": "failed to correctly query the database or parse claims",
                        "schema": {
                            "$ref": "#/definitions/dto.Error500"
                        }
                    }
                }
            }
        },
        "/wallet/deposit": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Takes inputted amount and adds it to wallet's balance",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "wallet"
                ],
                "summary": "Deposit funds to wallet",
                "parameters": [
                    {
                        "description": "Deposit payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.DepositRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.Wallet200Response"
                        }
                    },
                    "400": {
                        "description": "invalid request body",
                        "schema": {
                            "$ref": "#/definitions/dto.Error400"
                        }
                    },
                    "401": {
                        "description": "invalid authorization header",
                        "schema": {
                            "$ref": "#/definitions/dto.Error401"
                        }
                    },
                    "500": {
                        "description": "failed to correctly query the database or parse claims",
                        "schema": {
                            "$ref": "#/definitions/dto.Error500"
                        }
                    }
                }
            }
        },
        "/wallet/transfer": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Takes inputted amount from user's wallet and transfers it to another user's wallet",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "wallet"
                ],
                "summary": "Transfers funds between users",
                "parameters": [
                    {
                        "description": "Transfer payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.TransferRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.Wallet200Response"
                        }
                    },
                    "400": {
                        "description": "invalid request body",
                        "schema": {
                            "$ref": "#/definitions/dto.Error400"
                        }
                    },
                    "401": {
                        "description": "invalid authorization header",
                        "schema": {
                            "$ref": "#/definitions/dto.Error401"
                        }
                    },
                    "404": {
                        "description": "inputted username not found in database",
                        "schema": {
                            "$ref": "#/definitions/dto.Error404"
                        }
                    },
                    "422": {
                        "description": "cannot transfer to self",
                        "schema": {
                            "$ref": "#/definitions/dto.Error422Transfer"
                        }
                    },
                    "500": {
                        "description": "failed to correctly query the database or parse claims",
                        "schema": {
                            "$ref": "#/definitions/dto.Error500"
                        }
                    }
                }
            }
        },
        "/wallet/withdraw": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Takes inputted amount and subtracts it from wallet's balance",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "wallet"
                ],
                "summary": "Withdraws funds from wallet",
                "parameters": [
                    {
                        "description": "Withdraw payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.WithdrawRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.Wallet200Response"
                        }
                    },
                    "400": {
                        "description": "invalid request body",
                        "schema": {
                            "$ref": "#/definitions/dto.Error400"
                        }
                    },
                    "401": {
                        "description": "invalid authorization header",
                        "schema": {
                            "$ref": "#/definitions/dto.Error401"
                        }
                    },
                    "422": {
                        "description": "not enough balance to withdraw",
                        "schema": {
                            "$ref": "#/definitions/dto.Error422Withdraw"
                        }
                    },
                    "500": {
                        "description": "failed to correctly query the database or parse claims",
                        "schema": {
                            "$ref": "#/definitions/dto.Error500"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.DepositRequest": {
            "type": "object",
            "required": [
                "amount"
            ],
            "properties": {
                "amount": {
                    "type": "integer",
                    "example": 1000
                },
                "category": {
                    "type": "string",
                    "example": "salary"
                },
                "note": {
                    "type": "string",
                    "example": "Don't spend too much!"
                }
            }
        },
        "dto.Error400": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Invalid request body"
                }
            }
        },
        "dto.Error401": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "missing claims"
                }
            }
        },
        "dto.Error403": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "user not authorized to view this wallet"
                }
            }
        },
        "dto.Error404": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "username not found in records"
                }
            }
        },
        "dto.Error422Transfer": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "cannot transfer to self"
                }
            }
        },
        "dto.Error422Withdraw": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "insufficient funds"
                }
            }
        },
        "dto.Error500": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "failed to query database"
                }
            }
        },
        "dto.TransferRequest": {
            "type": "object",
            "required": [
                "amount",
                "to_user"
            ],
            "properties": {
                "amount": {
                    "type": "integer",
                    "example": 10000
                },
                "category": {
                    "type": "string",
                    "example": "Tips"
                },
                "note": {
                    "type": "string",
                    "example": "You earned it!"
                },
                "to_user": {
                    "type": "string",
                    "example": "Adam"
                }
            }
        },
        "dto.Wallet200Response": {
            "type": "object",
            "properties": {
                "balance": {
                    "type": "integer",
                    "example": 20000
                },
                "user_id": {
                    "type": "integer",
                    "example": 3
                }
            }
        },
        "dto.WithdrawRequest": {
            "type": "object",
            "required": [
                "amount"
            ],
            "properties": {
                "amount": {
                    "type": "integer",
                    "example": 500
                },
                "category": {
                    "type": "string",
                    "example": "food"
                },
                "note": {
                    "type": "string",
                    "example": "to buy chicken"
                }
            }
        },
        "handler.CategorySummary": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "count": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "handler.SummaryResult": {
            "type": "object",
            "properties": {
                "categories": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handler.CategorySummary"
                    }
                },
                "period": {
                    "type": "string",
                    "example": "2026-08"
                },
                "total": {
                    "type": "integer",
                    "example": 20000
                }
            }
        },
        "model.Transaction": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "integer"
                },
                "category": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string",
                    "example": "2026-08-13T22:08:50.997585+03:00"
                },
                "id": {
                    "type": "integer",
                    "example": 4
                },
                "note": {
                    "type": "string"
                },
                "related_wallet_id": {
                    "type": "integer"
                },
                "type": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string",
                    "example": "2026-08-13T22:08:50.997585+03:00"
                },
                "wallet_id": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Type \"Bearer\" followed by a space and your JWT.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}